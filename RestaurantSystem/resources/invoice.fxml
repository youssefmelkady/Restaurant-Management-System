<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurant.controller.InvoiceController"
      spacing="15"
      prefWidth="500"
      prefHeight="550"
      styleClass="main-container">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <Label text="Invoice"
           styleClass="title-label"/>

    <Separator/>

    <GridPane hgap="20"
              vgap="15">

        <Label text="Invoice ID:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <Label fx:id="invoiceIdLabel"
               text="-"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1"/>

        <Label text="Subtotal:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <Label fx:id="subtotalLabel"
               text="0.00 EGP"
               GridPane.rowIndex="1"
               GridPane.columnIndex="1"/>

        <Label text="Tax:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <Label fx:id="taxLabel"
               text="0.00 EGP"
               GridPane.rowIndex="2"
               GridPane.columnIndex="1"/>

        <Label text="Service Charge:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <Label fx:id="serviceChargeLabel"
               text="0.00 EGP"
               GridPane.rowIndex="3"
               GridPane.columnIndex="1"/>

        <Label text="Total:"
               styleClass="total-label"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <Label fx:id="totalLabel"
               text="0.00 EGP"
               styleClass="total-label"
               GridPane.rowIndex="4"
               GridPane.columnIndex="1"/>

        <Label text="Payment Status:"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <Label fx:id="paymentStatusLabel"
               text="Unpaid"
               GridPane.rowIndex="5"
               GridPane.columnIndex="1"/>

        <Label text="Payment Method:"
               GridPane.rowIndex="6"
               GridPane.columnIndex="0"/>

        <Label fx:id="paymentMethodLabel"
               text="-"
               GridPane.rowIndex="6"
               GridPane.columnIndex="1"/>

    </GridPane>

    <Separator/>

    <Button fx:id="backButton"
            text="Back"
            onAction="#handleBack"
            prefWidth="150"
            styleClass="secondary-button"/>

</VBox>