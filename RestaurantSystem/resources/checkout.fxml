<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.restaurant.controller.CheckoutController"
            stylesheets="@css/styles.css" prefWidth="780" prefHeight="620">

    <!--Top part-->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="navbar">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Label text="Checkout &amp; Payment" styleClass="navbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#handleBack" styleClass="button-danger"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="20">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!--Invoice-->
            <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Select Order:" styleClass="section-title"/>
                <ComboBox fx:id="orderComboBox" maxWidth="Infinity"/>
                <Separator/>

                <GridPane hgap="10" vgap="8">
                    <Label text="Invoice ID:"     GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="invoiceIdLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Order ID:"       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="orderIdLabel"   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Subtotal:"       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="subtotalLabel"  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Tax (14%):"      GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label fx:id="taxLabel"       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Service (12%):"  GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label fx:id="serviceChargeLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="TOTAL:"           GridPane.columnIndex="0" GridPane.rowIndex="5"
                           style="-fx-font-weight:bold;"/>
                    <Label fx:id="totalLabel"      GridPane.columnIndex="1" GridPane.rowIndex="5"
                           styleClass="stat-label"/>
                </GridPane>

                <Separator/>

                <TextArea fx:id="invoiceArea" editable="false" prefHeight="160" wrapText="true"
                          style="-fx-font-family: monospace; -fx-font-size: 12px;"/>
            </VBox>

            <!--Payment choices-->
            <VBox spacing="15" prefWidth="220" styleClass="card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Payment Method" styleClass="card-title"/>
                <Separator/>

                <RadioButton fx:id="rbCash" text="Cash">
                    <toggleGroup><ToggleGroup fx:id="paymentGroup"/></toggleGroup>
                </RadioButton>

                <RadioButton fx:id="rbCard" text="Credit Card" toggleGroup="$paymentGroup"/>
                <RadioButton fx:id="rbBalance" text="Balance" toggleGroup="$paymentGroup"/>
                <RadioButton fx:id="rbLoyalty" text="Loyalty Points" toggleGroup="$paymentGroup"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Confirm Payment" onAction="#confirmPayment"
                        styleClass="button-success" maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>