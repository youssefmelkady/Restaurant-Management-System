<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurant.controller.LoginController"
      stylesheets="@css/styles.css"
      alignment="CENTER" spacing="20" prefWidth="420" prefHeight="460">

    <padding><Insets top="50" right="60" bottom="50" left="60"/></padding>

    <Label text="Restaurant System" styleClass="title-label"/>
    <Label text="Sign In" styleClass="subtitle-label"/>

    <VBox spacing="8">
        <Label text="Username"/>
        <TextField fx:id="usernameField" promptText="Enter username"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Password"/>
        <PasswordField fx:id="passwordField" promptText="Enter password"/>
    </VBox>

    <HBox spacing="30" alignment="CENTER">
        <Label text="Login as:"/>
        <RadioButton fx:id="rbCustomer" text="Customer" selected="true">
            <toggleGroup><ToggleGroup fx:id="roleGroup"/></toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbStaff" text="Staff" toggleGroup="$roleGroup"/>
    </HBox>

    <Button text="Login" onAction="#handleLogin" styleClass="button-primary" maxWidth="Infinity"/>
    <Button text="Create Account" onAction="#handleGoRegister" styleClass="button-secondary" maxWidth="Infinity"/>
</VBox>
