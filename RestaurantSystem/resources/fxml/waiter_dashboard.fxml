<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.restaurant.controller.WaiterController"
            stylesheets="@css/styles.css" prefWidth="800" prefHeight="600">

    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="navbar">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Label text="Waiter Dashboard" styleClass="navbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="button-danger"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="20">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- Orders List -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="All Orders" styleClass="section-title"/>
                <ListView fx:id="orderListView" VBox.vgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="New Status:"/>
                    <ComboBox fx:id="statusComboBox" prefWidth="160"/>
                    <Button text="Update Status" onAction="#handleUpdateStatus" styleClass="button-primary"/>
                </HBox>
            </VBox>

            <!-- Live Feed (BONUS) -->
            <VBox spacing="10" prefWidth="260" styleClass="card">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <Label text="Live Order Feed (Bonus)" styleClass="card-title"/>
                <Label text="Updates broadcast to all connected screens" style="-fx-font-size:11px; -fx-text-fill:#888;"/>
                <TextArea fx:id="liveFeedArea" editable="false" VBox.vgrow="ALWAYS" wrapText="true"
                          style="-fx-font-family: monospace; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
