<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurant.controller.CheckoutController"
      stylesheets="@../css/style.css"
      alignment="CENTER"
      spacing="15"
      prefWidth="500"
      prefHeight="600">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <Label text="Restaurant Management System"/>

    <Label text="Checkout / Payment"/>

    <Label text="Invoice"/>

    <Label fx:id="invoiceIdLabel"
           text="Invoice ID: INV-001"/>

    <Label fx:id="orderIdLabel"
           text="Order ID: ORD-001"/>

    <Label fx:id="subtotalLabel"
           text="Subtotal: 0.00 EGP"/>

    <Label fx:id="taxLabel"
           text="Tax: 0.00 EGP"/>

    <Label fx:id="serviceChargeLabel"
           text="Service Charge: 0.00 EGP"/>

    <Label fx:id="totalLabel"
           text="Total: 0.00 EGP"/>

    <Label text="Payment Method"/>

    <ComboBox fx:id="paymentMethod"
              promptText="Select payment method"/>

    <Button fx:id="confirmPaymentButton"
            text="Confirm Payment"
            onAction="#confirmPayment"/>

    <Button fx:id="viewInvoiceButton"
            text="View Invoice"
            onAction="#viewInvoice"
            disable="true"/>

</VBox>