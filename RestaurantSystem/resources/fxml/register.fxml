<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurant.controller.RegisterController"
      stylesheets="@css/styles.css"
      alignment="CENTER" spacing="16" prefWidth="440" prefHeight="580">

    <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

    <Label text="Create Account" styleClass="title-label"/>

    <VBox spacing="6">
        <Label text="Username *"/>
        <TextField fx:id="usernameField" promptText="Choose a username"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Password * (min 8 chars, 1 uppercase, 1 digit, 1 special)"/>
        <PasswordField fx:id="passwordField" promptText="Choose a strong password"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Phone Number * (01XXXXXXXXX)"/>
        <TextField fx:id="phoneField" promptText="01012345678"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Date of Birth *"/>
        <DatePicker fx:id="dobPicker" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Dietary Preferences"/>
        <TextField fx:id="dietaryField" promptText="e.g. Vegetarian, No nuts"/>
    </VBox>

    <Button text="Register" onAction="#handleRegister" styleClass="button-primary" maxWidth="Infinity"/>
    <Button text="Back to Login" onAction="#handleBackToLogin" styleClass="button-secondary" maxWidth="Infinity"/>
</VBox>
