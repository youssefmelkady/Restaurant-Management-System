<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurant.gui.RegisterController"
      spacing="10" alignment="CENTER" prefWidth="420" prefHeight="520">

    <padding>
        <Insets top="25" right="40" bottom="25" left="40"/>
    </padding>

    <Label text="Create Account" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Username"/>
    <TextField fx:id="usernameField" promptText="Choose a username"/>

    <Label text="Password"/>
    <PasswordField fx:id="passwordField" promptText="Min 8 chars, upper, lower, digit, symbol"/>

    <Label text="Phone Number"/>
    <TextField fx:id="phoneField" promptText="01xxxxxxxxx"/>

    <Label text="Date of Birth"/>
    <DatePicker fx:id="dobPicker"/>

    <Label text="Dietary Preferences"/>
    <TextField fx:id="dietaryField" promptText="e.g. Vegetarian, None"/>

    <Button text="Register" onAction="#handleRegister" prefWidth="150"/>
    <Button text="Back to Login" onAction="#handleBackToLogin" prefWidth="150"/>

    <Label fx:id="messageLabel" wrapText="true"/>

</VBox>